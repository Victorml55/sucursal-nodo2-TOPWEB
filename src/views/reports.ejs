<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reportes Administrativos - Sucursal</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #0e1117;
      background-image: 
        radial-gradient(at 50% 0%, rgba(20, 30, 45, 0.6) 0px, transparent 75%),
        radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
      background-size: 100% 100%, 20px 20px;
    }
    @media print {
      body { background: white !important; color: black !important; }
      header, .no-print { display: none !important; }
      .print-card { border: 1px solid #ccc !important; background: white !important; color: black !important; box-shadow: none !important; }
      .print-text { color: black !important; }
    }
  </style>
</head>
<body class="text-stone-300 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Superior -->
  <header class="border-b border-stone-800/80 bg-[#121620]/80 backdrop-blur-md px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-stone-800 border border-stone-700/60 flex items-center justify-center text-stone-200">
          <i data-lucide="file-bar-chart" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-[10px] font-bold tracking-wider text-stone-400 uppercase">Sistema Bancario Distribuido</p>
          <h1 class="text-sm font-bold text-stone-100 tracking-tight">
            Reportes Administrativos <span class="text-xs font-normal text-stone-400">(Nodo 2 Sucursal)</span>
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button onclick="window.print()" class="no-print px-3.5 py-1.5 rounded-lg bg-emerald-800 hover:bg-emerald-700 border border-emerald-600/30 text-emerald-100 text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 cursor-pointer">
          <i data-lucide="printer" class="w-3.5 h-3.5"></i>
          <span>Imprimir Reporte</span>
        </button>
        <a href="/dashboard" class="no-print px-3.5 py-1.5 rounded-lg bg-stone-800/80 hover:bg-stone-700 border border-stone-700/60 text-stone-300 text-xs font-medium transition-all flex items-center gap-1.5">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
          <span>Dashboard</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 w-full flex-1">
    
    <!-- Encabezado del Reporte Oficial -->
    <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-6 shadow-xl shadow-black/40 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-stone-800/80 border border-stone-700/60 text-[10px] font-bold uppercase tracking-wider text-stone-300 mb-2">
          <span>Nodo 2 &bull; Sucursal Centro</span>
        </div>
        <h2 class="text-xl font-bold text-stone-100 tracking-tight print-text">Corte Operativo y Balance de Administración</h2>
        <p class="text-xs text-stone-400 mt-1 print-text">Fecha de Emisión: <%= fechaEmision %></p>
      </div>

      <div class="text-right">
        <span class="text-[10px] uppercase font-bold text-stone-500 tracking-widest block">Estatus de Auditoría</span>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 mt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Consolidado con Banco Central
        </span>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-xl bg-rose-950/40 border border-rose-800/50 text-rose-300 text-xs flex items-center gap-3 mb-8">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-400 shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      
      <!-- Cuentas -->
      <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total Cuentas</p>
        <p class="text-2xl font-bold text-stone-100 mt-2 print-text"><%= report.total_cuentas || 0 %></p>
        <p class="text-[11px] text-stone-500 mt-2">Registradas en la red</p>
      </div>

      <!-- Depósitos Totales -->
      <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total Depósitos</p>
        <p class="text-2xl font-bold text-emerald-400 mt-2">$<%= Number(report.total_depositos || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></p>
        <p class="text-[11px] text-stone-500 mt-2">Ingresos por captación</p>
      </div>

      <!-- Retiros Totales -->
      <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total Retiros</p>
        <p class="text-2xl font-bold text-rose-400 mt-2">$<%= Number(report.total_retiros || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></p>
        <p class="text-[11px] text-stone-500 mt-2">Egresos procesados</p>
      </div>

      <!-- Efectivo en Caja -->
      <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Efectivo en Caja</p>
        <p class="text-2xl font-bold text-amber-400 mt-2">$<%= Number(report.efectivo_caja || 16499).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></p>
        <p class="text-[11px] text-stone-500 mt-2">Disponible en Nodo 2</p>
      </div>

    </div>

    <!-- Bitácora de Transacciones para Auditoría -->
    <div class="bg-[#151922] print-card border border-stone-800/90 rounded-2xl p-6 shadow-xl shadow-black/40">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-stone-800">
        <h3 class="text-sm font-bold text-stone-100 tracking-tight flex items-center gap-2 print-text">
          <i data-lucide="list-checks" class="w-4 h-4 text-emerald-400"></i>
          <span>Desglose Operativo de Transacciones</span>
        </h3>
        <span class="text-xs text-stone-500"><%= (report.operaciones || []).length %> movimiento(s) auditado(s)</span>
      </div>

      <% if (report.operaciones && report.operaciones.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-stone-400 uppercase border-b border-stone-800/80 text-[10px] tracking-wider">
                <th class="pb-3 font-semibold">Folio / Tipo</th>
                <th class="pb-3 font-semibold">Cuenta</th>
                <th class="pb-3 font-semibold">Titular</th>
                <th class="pb-3 font-semibold">Monto</th>
                <th class="pb-3 font-semibold text-right">Fecha</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-800/50 text-stone-300">
              <% report.operaciones.forEach(op => { %>
                <tr class="hover:bg-stone-900/40 transition-colors">
                  <td class="py-3 font-medium">
                    <span class="text-stone-500 font-mono">#<%= op.id %></span> &bull; 
                    <span class="<%= op.tipo === 'deposito' ? 'text-emerald-400' : 'text-rose-400' %> uppercase font-bold text-[11px] ml-1">
                      <%= op.tipo %>
                    </span>
                  </td>
                  <td class="py-3 font-mono text-stone-300"><%= op.cuenta || '1000000086' %></td>
                  <td class="py-3 font-bold text-stone-100 print-text"><%= op.titular || 'Victor ML' %></td>
                  <td class="py-3 font-bold text-stone-100 print-text">
                    <%= op.tipo === 'deposito' ? '+' : '-' %>$<%= Number(op.monto).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %>
                  </td>
                  <td class="py-3 text-stone-500 text-right font-mono text-[11px]">
                    <%= new Date(op.created_at || Date.now()).toLocaleString() %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-8 text-stone-500 text-xs">
          No hay transacciones registradas en el período actual.
        </div>
      <% } %>

    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-800/60 bg-[#121620]/60 py-3 text-center text-xs text-stone-500">
    <p>Sistema Bancario Distribuido &bull; Nodo 2 Sucursal Administrativa</p>
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>