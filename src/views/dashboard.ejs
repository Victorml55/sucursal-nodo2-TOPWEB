<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Sucursal Administrativa</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #0e1117;
      background-image: 
        radial-gradient(at 50% 0%, rgba(20, 30, 45, 0.6) 0px, transparent 75%),
        radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
      background-size: 100% 100%, 20px 20px;
    }
  </style>
</head>
<body class="text-stone-300 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Principal -->
  <header class="border-b border-stone-800/80 bg-[#121620]/80 backdrop-blur-md px-6 py-4">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-stone-800 border border-stone-700/60 flex items-center justify-center text-stone-200">
          <i data-lucide="building-2" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-[10px] font-bold tracking-wider text-stone-400 uppercase">Panel Administrativo</p>
          <h1 class="text-sm font-bold text-stone-100 tracking-tight">
            Sucursal Administrativa <span class="text-xs font-normal text-stone-400">(Nodo 2)</span>
          </h1>
        </div>
      </div>
      
      <div class="flex items-center gap-4">
        <div class="text-right hidden sm:block">
          <p class="text-xs font-semibold text-stone-200"><%= typeof user !== 'undefined' ? (user.email || user) : 'ejecutivo1@sucursal.com' %></p>
          <p class="text-[10px] text-emerald-400 font-medium">Ejecutivo de Cuenta</p>
        </div>

        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/50 border border-emerald-800/40 text-emerald-400 text-xs font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          En Servicio
        </div>

        <a href="/logout" class="px-3.5 py-1.5 bg-stone-800/80 hover:bg-rose-950/40 hover:border-rose-800/50 hover:text-rose-300 border border-stone-700/60 rounded-lg text-xs font-medium text-stone-300 transition-all flex items-center gap-1.5">
          <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
          Salir
        </a>
      </div>
    </div>
  </header>

  <!-- Contenido Principal -->
  <main class="max-w-7xl mx-auto px-6 py-8 w-full flex-1">
    
    <% if (typeof notification !== 'undefined' && notification) { %>
      <% if (notification.type === 'success') { %>
        <!-- Banner Flotante de Confirmación de Cuenta Creada -->
        <div id="toastNotification" class="mb-8 p-4 rounded-2xl bg-emerald-950/70 border border-emerald-500/40 text-emerald-200 shadow-2xl shadow-black/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-all">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center shrink-0">
              <i data-lucide="check-circle-2" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-emerald-100"><%= notification.title %></p>
              <p class="text-xs text-emerald-300/80 mt-0.5">
                Titular: <strong class="text-emerald-100"><%= notification.titular %></strong> &bull; Número de Cuenta: <span class="font-mono bg-emerald-900/60 px-2 py-0.5 rounded text-emerald-200 font-bold"><%= notification.account %></span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2.5 self-end sm:self-auto">
            <a href="/search-account?numero_cuenta=<%= notification.account %>" class="px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-600 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-md shadow-emerald-950/40">
              <i data-lucide="eye" class="w-3.5 h-3.5"></i>
              <span>Ver Detalle</span>
            </a>
            <button onclick="document.getElementById('toastNotification').remove()" class="p-1.5 hover:bg-emerald-900/60 rounded-lg text-emerald-400 hover:text-emerald-200 transition-colors">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      <% } else if (notification.type === 'error') { %>
        <!-- Banner Flotante de Error -->
        <div id="toastNotification" class="mb-8 p-4 rounded-2xl bg-rose-950/70 border border-rose-500/40 text-rose-200 shadow-2xl shadow-black/60 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center shrink-0">
              <i data-lucide="alert-circle" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-rose-100">Ocurrió un problema</p>
              <p class="text-xs text-rose-300/80 mt-0.5"><%= notification.message %></p>
            </div>
          </div>
          <button onclick="document.getElementById('toastNotification').remove()" class="p-1.5 hover:bg-rose-900/60 rounded-lg text-rose-400 hover:text-rose-200 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      <% } %>
    <% } %>

    <!-- Grid de Métricas de Estado -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      
      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Efectivo en Caja</p>
            <p class="text-2xl font-bold text-stone-100 mt-1.5">$<%= typeof nodeInfo !== 'undefined' && nodeInfo.efectivo_disponible ? nodeInfo.efectivo_disponible : '16,499.00' %></p>
          </div>
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
            <i data-lucide="wallet" class="w-5 h-5"></i>
          </div>
        </div>
        <p class="text-[11px] text-stone-500 mt-3">Sincronizado con Banco Central</p>
      </div>

      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado Central</p>
            <p class="text-xl font-bold text-emerald-400 mt-1.5">Conectado</p>
          </div>
          <div class="w-9 h-9 rounded-xl bg-stone-800 border border-stone-700/60 flex items-center justify-center text-stone-300">
            <i data-lucide="server" class="w-5 h-5"></i>
          </div>
        </div>
        <p class="text-[11px] text-stone-500 mt-3">Nodo 2 &bull; Sucursal Centro</p>
      </div>

      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Tipo de Nodo</p>
            <p class="text-xl font-bold text-stone-100 mt-1.5">Sucursal #02</p>
          </div>
          <div class="w-9 h-9 rounded-xl bg-stone-800 border border-stone-700/60 flex items-center justify-center text-stone-300">
            <i data-lucide="building" class="w-5 h-5"></i>
          </div>
        </div>
        <p class="text-[11px] text-stone-500 mt-3">Alta de Cuentas Autorizada</p>
      </div>

      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-5 shadow-xl shadow-black/40">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Persistencia Local</p>
            <p class="text-xl font-bold text-stone-200 mt-1.5">Supabase</p>
          </div>
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
            <i data-lucide="database" class="w-5 h-5"></i>
          </div>
        </div>
        <p class="text-[11px] text-stone-500 mt-3">Base de datos operativa</p>
      </div>

    </div>

    <!-- Módulos de Operación -->
    <h2 class="text-xs font-bold uppercase tracking-wider text-stone-400 mb-4">Operaciones de Sucursal</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      
      <!-- Acción 1: Apertura de Cuenta -->
      <a href="/new-client" class="group bg-[#151922] hover:bg-[#1a202c] border border-stone-800/90 hover:border-stone-700 rounded-2xl p-6 transition-all duration-200 block shadow-xl shadow-black/40">
        <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
          <i data-lucide="user-plus" class="w-5 h-5"></i>
        </div>
        <h3 class="text-base font-bold text-stone-100 group-hover:text-emerald-400 transition-colors">Apertura de Cuenta</h3>
        <p class="text-xs text-stone-400 mt-1.5 leading-relaxed">Registra un nuevo cuentahabiente en la red del Banco Central con saldo inicial.</p>
        <div class="mt-5 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400">
          <span>Abrir formulario</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>

      <!-- Acción 2: Consultar Cuentas -->
      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-6 shadow-xl shadow-black/40 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 rounded-xl bg-stone-800 border border-stone-700/60 text-stone-300 flex items-center justify-center mb-4">
            <i data-lucide="search" class="w-5 h-5"></i>
          </div>
          <h3 class="text-base font-bold text-stone-100">Consultar Cuenta</h3>
          <p class="text-xs text-stone-400 mt-1.5 leading-relaxed">Verifica el balance y titularidad de un cliente en la red bancaria.</p>
        </div>
        <form action="/search-account" method="GET" class="mt-4 flex gap-2">
          <input 
            type="text" 
            name="numero_cuenta" 
            placeholder="Número de cuenta..." 
            required
            class="w-full px-3 py-2 bg-[#0d1017] border border-stone-800 rounded-xl text-xs text-stone-100 placeholder-stone-600 focus:outline-none focus:border-stone-600"
          >
          <button type="submit" class="px-3.5 py-2 bg-stone-800 hover:bg-stone-700 border border-stone-700/60 text-stone-200 rounded-xl text-xs font-semibold shrink-0">Buscar</button>
        </form>
      </div>

      <!-- Acción 3: Reportes Administrativos -->
      <a href="/reports" class="group bg-[#151922] hover:bg-[#1a202c] border border-stone-800/90 hover:border-stone-700 rounded-2xl p-6 transition-all duration-200 block shadow-xl shadow-black/40">
        <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
          <i data-lucide="file-text" class="w-5 h-5"></i>
        </div>
        <h3 class="text-base font-bold text-stone-100 group-hover:text-amber-400 transition-colors">Reportes Administrativos</h3>
        <p class="text-xs text-stone-400 mt-1.5 leading-relaxed">Genera e imprime cortes de caja y balance de operaciones de la sucursal.</p>
        <div class="mt-5 inline-flex items-center gap-1.5 text-xs font-bold text-amber-400">
          <span>Ver reporte de operaciones</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>

    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-800/60 bg-[#121620]/60 py-3 text-center text-xs text-stone-500">
    <p>Sistema Bancario Distribuido &bull; Nodo 2 Sucursal Administrativa</p>
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>