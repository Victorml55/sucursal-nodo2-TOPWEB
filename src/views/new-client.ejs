<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apertura de Cuenta - Sucursal</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #0e1117;
      background-image: 
        radial-gradient(at 50% 0%, rgba(20, 30, 45, 0.6) 0px, transparent 75%),
        radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
      background-size: 100% 100%, 20px 20px;
    }
  </style>
</head>
<body class="text-stone-300 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Superior -->
  <header class="border-b border-stone-800/80 bg-[#121620]/80 backdrop-blur-md px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-stone-800 border border-stone-700/60 flex items-center justify-center text-stone-200">
          <i data-lucide="building-2" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-[10px] font-bold tracking-wider text-stone-400 uppercase">Sistema Bancario Distribuido</p>
          <h1 class="text-sm font-bold text-stone-100 tracking-tight">
            Sucursal Administrativa <span class="text-xs font-normal text-stone-400">(Nodo 2)</span>
          </h1>
        </div>
      </div>

      <a href="/dashboard" class="px-3.5 py-1.5 rounded-lg bg-stone-800/80 hover:bg-stone-700 border border-stone-700/60 text-stone-300 text-xs font-medium transition-all flex items-center gap-1.5">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        <span>Volver al Dashboard</span>
      </a>
    </div>
  </header>

  <!-- Formulario de Alta de Cliente -->
  <main class="flex-1 flex items-center justify-center p-4 sm:p-6">
    <div class="w-full max-w-lg">
      
      <div class="bg-[#151922] border border-stone-800/90 rounded-2xl p-8 shadow-2xl shadow-black/50 relative overflow-hidden">
        
        <!-- Header del Formulario -->
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-stone-800/80">
          <div>
            <h2 class="text-xl font-bold text-stone-100 tracking-tight">Apertura de Cuenta</h2>
            <p class="text-xs text-stone-400 mt-0.5">Registro oficial de cuentahabiente en la red Central</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <i data-lucide="user-plus" class="w-5 h-5"></i>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <!-- Alerta de Error -->
          <div class="mb-6 p-4 rounded-xl bg-rose-950/40 border border-rose-800/50 text-rose-300 text-xs flex items-center gap-3">
            <i data-lucide="alert-circle" class="w-4 h-4 text-rose-400 shrink-0"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/create-account" method="POST" id="accountForm" class="space-y-5">
          
          <!-- Nombre del Titular -->
          <div>
            <label for="titular" class="block text-xs font-semibold uppercase tracking-wider text-stone-400 mb-2">
              Nombre Completo del Titular
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-500">
                <i data-lucide="user" class="w-4 h-4"></i>
              </div>
              <input 
                type="text" 
                id="titular" 
                name="titular" 
                required 
                placeholder="Ej. Juan Pérez" 
                class="w-full pl-10 pr-4 py-2.5 bg-[#0d1017] border border-stone-800 rounded-xl text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-stone-600 focus:ring-1 focus:ring-stone-600 transition-all font-medium"
              />
            </div>
          </div>

          <!-- Saldo Inicial -->
          <div>
            <label for="saldo_inicial" class="block text-xs font-semibold uppercase tracking-wider text-stone-400 mb-2">
              Saldo Inicial ($)
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-500">
                <i data-lucide="dollar-sign" class="w-4 h-4"></i>
              </div>
              <input 
                type="number" 
                id="saldo_inicial" 
                name="saldo_inicial" 
                min="0" 
                step="any" 
                required 
                placeholder="1000" 
                class="w-full pl-10 pr-4 py-2.5 bg-[#0d1017] border border-stone-800 rounded-xl text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-stone-600 focus:ring-1 focus:ring-stone-600 transition-all font-medium"
              />
            </div>
          </div>

          <!-- Nota Informativa -->
          <div class="p-3.5 rounded-xl bg-stone-900/60 border border-stone-800/80 text-[11px] text-stone-400 flex items-start gap-2.5">
            <i data-lucide="info" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
            <span>El número de cuenta de 10 dígitos se asignará automáticamente desde el Banco Central al procesar el alta.</span>
          </div>

          <!-- Botón Registrar -->
          <button 
            type="submit" 
            id="submitBtn"
            class="w-full py-3 px-4 bg-emerald-800 hover:bg-emerald-700 active:bg-emerald-900 text-emerald-100 text-xs font-bold uppercase tracking-wider rounded-xl transition-all border border-emerald-600/30 shadow-lg shadow-emerald-950/50 cursor-pointer flex items-center justify-center gap-2 mt-2"
          >
            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            <span>Registrar Cuenta</span>
          </button>
        </form>

      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-800/60 bg-[#121620]/60 py-3 text-center text-xs text-stone-500">
    <p>Sistema Bancario Distribuido &bull; Nodo 2 Sucursal</p>
  </footer>

  <script>
    lucide.createIcons();

    const form = document.getElementById('accountForm');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', () => {
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      submitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-emerald-100" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Procesando en Central...</span>
      `;
    });
  </script>
</body>
</html>